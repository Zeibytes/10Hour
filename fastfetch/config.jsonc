{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/fedora.txt",
    "color": {
      "1": "white",
      "2": "bright_white"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },

  "display": {
    "separator": " ",
    "color": {
      "keys": "white",
      "title": "bright_white"
    },
    "percent": {
      "type": 5,
      "colorGreen": "white",
      "colorYellow": "bright_white",
      "colorRed": "white"
    }
  },

  "modules": [
    "title",
    "separator",

    {
      "type": "command",
      "text": "─── Hardware ───"
    },

    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "white"
    },

    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "white"
    },

    {
      "type": "memory",
      "key": "󰘚 RAM",
      "keyColor": "white"
    },

    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "white"
    },

    "break",

    {
      "type": "command",
      "text": "─── Software ───"
    },

    {
      "type": "os",
      "key": "󰌢 OS",
      "keyColor": "white"
    },

    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "white"
    },

    {
      "type": "shell",
      "key": "󰆍 Shell",
      "keyColor": "white"
    },

    {
      "type": "de",
      "key": "󰖲 DE",
      "keyColor": "white"
    },

    {
      "type": "wm",
      "key": "󰖳 WM",
      "keyColor": "white"
    },

    "break",

    {
      "type": "command",
      "text": "─── Network ───"
    },

    {
      "type": "localip",
      "key": "󰩟 Local IP",
      "showIpv6": false,
      "keyColor": "white"
    },

    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "white"
    },

    {
      "type": "uptime",
      "key": "󰔚 Uptime",
      "keyColor": "white"
    },

    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
